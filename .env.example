# SHA-256 hash of a separate random 32-byte hex private access key. Never commit the key.
ACCESS_KEY_HASH=replace-with-64-lowercase-hex-hash
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Same backend secret as Apps Script Script Properties; never use as browser key.
SHEETS_API_SECRET=replace-with-a-random-secret-at-least-32-characters
# Set to firestore after a verified migration; sheets remains the default.
LEDGER_BACKEND=sheets
LEDGER_READ_ONLY=false
FIREBASE_PROJECT_ID=littlepay-b16d6
# Server-only service account JSON. Never commit a real value or expose in public/.
FIREBASE_SERVICE_ACCOUNT_JSON=

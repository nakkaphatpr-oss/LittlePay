# Public OAuth client ID. No client secret is needed for Google Identity Services.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Single owner. Must match the verified Google account email.
ALLOWED_EMAIL=you@gmail.com
# Apps Script deployment URL ending in /exec (never /dev).
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Generate 32 random bytes. Set the same value in Apps Script Script Properties.
SHEETS_API_SECRET=replace-with-a-random-secret-at-least-32-characters
